am--refresh: Makefile
	@:
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(srcdir)/lib/sqfs/Makemodule.am $(srcdir)/lib/util/Makemodule.am $(srcdir)/lib/io/Makemodule.am $(srcdir)/lib/fstree/Makemodule.am $(srcdir)/lib/common/Makemodule.am $(srcdir)/lib/tar/Makemodule.am $(srcdir)/lib/compat/Makemodule.am $(srcdir)/bin/gensquashfs/Makemodule.am $(srcdir)/bin/rdsquashfs/Makemodule.am $(srcdir)/bin/sqfs2tar/Makemodule.am $(srcdir)/bin/sqfsdiff/Makemodule.am $(srcdir)/bin/tar2sqfs/Makemodule.am $(srcdir)/extras/Makemodule.am $(srcdir)/tests/libutil/Makemodule.am $(srcdir)/tests/libio/Makemodule.am $(srcdir)/tests/libfstree/Makemodule.am $(srcdir)/tests/libtar/Makemodule.am $(srcdir)/tests/libsqfs/Makemodule.am $(srcdir)/tests/gensquashfs/Makemodule.am $(srcdir)/tests/rdsquashfs/Makemodule.am $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --foreign'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --foreign \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles);; \
	esac;
$(srcdir)/lib/sqfs/Makemodule.am $(srcdir)/lib/util/Makemodule.am $(srcdir)/lib/io/Makemodule.am $(srcdir)/lib/fstree/Makemodule.am $(srcdir)/lib/common/Makemodule.am $(srcdir)/lib/tar/Makemodule.am $(srcdir)/lib/compat/Makemodule.am $(srcdir)/bin/gensquashfs/Makemodule.am $(srcdir)/bin/rdsquashfs/Makemodule.am $(srcdir)/bin/sqfs2tar/Makemodule.am $(srcdir)/bin/sqfsdiff/Makemodule.am $(srcdir)/bin/tar2sqfs/Makemodule.am $(srcdir)/extras/Makemodule.am $(srcdir)/tests/libutil/Makemodule.am $(srcdir)/tests/libio/Makemodule.am $(srcdir)/tests/libfstree/Makemodule.am $(srcdir)/tests/libtar/Makemodule.am $(srcdir)/tests/libsqfs/Makemodule.am $(srcdir)/tests/gensquashfs/Makemodule.am $(srcdir)/tests/rdsquashfs/Makemodule.am $(am__empty):

