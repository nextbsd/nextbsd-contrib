--- a/libpkg/private/nextbsd_policy.h
+++ b/libpkg/private/nextbsd_policy.h
@@ -0,0 +1,27 @@
+/*
+ * NextBSD: which packages may be installed, and from where.
+ *
+ * pkg_jobs_universe.c drops pkg and pkg-devel from any repository other than
+ * NextBSD while the job universe is built. The checks declared here run just
+ * before anything is extracted: nextbsd_check_jobs() from pkg_jobs_execute()
+ * for pkg install/upgrade (repository packages and package files alike), and
+ * nextbsd_check_install() from pkg_add_common() for every package pkg_add()
+ * or a job installs, which covers pkg add.
+ */
+#ifndef NEXTBSD_POLICY_H
+#define NEXTBSD_POLICY_H
+
+#include <stdbool.h>
+
+struct pkg;
+struct pkgdb;
+struct pkg_jobs;
+
+#define	NEXTBSD_PKG_REPO	"NextBSD"
+#define	NEXTBSD_ORIGIN_KEY	"org.nextbsd.origin"
+#define	NEXTBSD_ORIGIN_VALUE	"NextBSD"
+
+int	nextbsd_check_install(const struct pkg *pkg, const struct pkg *source);
+int	nextbsd_check_jobs(struct pkg_jobs *j);
+
+#endif /* NEXTBSD_POLICY_H */
--- a/libpkg/nextbsd_policy.c
+++ b/libpkg/nextbsd_policy.c
@@ -0,0 +1,99 @@
+/*
+ * NextBSD: which packages may be installed, and from where.
+ * See private/nextbsd_policy.h.
+ */
+
+#include "pkg_config.h"
+
+#include <sys/param.h>
+#include <sys/types.h>
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pkg.h"
+#include "private/event.h"
+#include "private/pkg.h"
+#include "private/pkgdb.h"
+#include "private/pkg_jobs.h"
+#include "private/nextbsd_policy.h"
+
+/*
+ * A package arrives either from a repository (source is the remote package,
+ * PKG_REMOTE, whose reponame says which) or from a local package file (pkg
+ * add, or pkg install ./file: no source, or a PKG_FILE source). A package
+ * file is a NextBSD package when its manifest carries the annotation
+ * org.nextbsd.origin=NextBSD, which nextbsd-pkg stamps on every package it
+ * builds.
+ */
+static bool
+nextbsd_from_repo(const struct pkg *source)
+{
+	return (source != NULL && source->type == PKG_REMOTE);
+}
+
+static bool
+nextbsd_trusted(const struct pkg *pkg, const struct pkg *source)
+{
+	const char *v;
+
+	if (nextbsd_from_repo(source))
+		return (source->reponame != NULL &&
+		    STREQ(source->reponame, NEXTBSD_PKG_REPO));
+	v = pkg_kv_get(&pkg->annotations, NEXTBSD_ORIGIN_KEY);
+	return (v != NULL && STREQ(v, NEXTBSD_ORIGIN_VALUE));
+}
+
+int
+nextbsd_check_install(const struct pkg *pkg, const struct pkg *source)
+{
+	bool trusted = nextbsd_trusted(pkg, source);
+
+	/*
+	 * pkg itself comes only from NextBSD: from the NextBSD repository (the
+	 * universe filter sees to that) or from a package file that is a
+	 * NextBSD package.
+	 */
+	if (!trusted && !nextbsd_from_repo(source) &&
+	    (STREQ(pkg->name, "pkg") || STREQ(pkg->name, "pkg-devel"))) {
+		pkg_emit_error("NextBSD: refusing to install %s-%s from a "
+		    "package file that is not a NextBSD package (no "
+		    NEXTBSD_ORIGIN_KEY "=" NEXTBSD_ORIGIN_VALUE " annotation): "
+		    "pkg comes only from NextBSD",
+		    pkg->name, pkg->version);
+		return (EPKG_FATAL);
+	}
+	return (EPKG_OK);
+}
+
+/*
+ * Every package a job is about to install or upgrade to, before any of
+ * them is extracted, so a refusal stops the whole transaction.
+ */
+int
+nextbsd_check_jobs(struct pkg_jobs *j)
+{
+	vec_foreach(j->jobs, i) {
+		struct pkg_solved *ps = j->jobs.d[i];
+		struct pkg *p;
+
+		if (ps->type == PKG_SOLVED_DELETE ||
+		    ps->type == PKG_SOLVED_UPGRADE_REMOVE ||
+		    ps->type == PKG_SOLVED_FETCH)
+			continue;
+		p = ps->items[0]->pkg;
+		if (p->type != PKG_REMOTE && p->type != PKG_FILE)
+			continue;
+		if (p->type == PKG_REMOTE &&
+		    pkgdb_ensure_loaded(j->db, p,
+		    PKG_LOAD_FILES|PKG_LOAD_DIRS) != EPKG_OK) {
+			pkg_emit_error("NextBSD: cannot read the file list "
+			    "of %s-%s", p->name, p->version);
+			return (EPKG_FATAL);
+		}
+		if (nextbsd_check_install(p, p) != EPKG_OK)
+			return (EPKG_FATAL);
+	}
+	return (EPKG_OK);
+}
