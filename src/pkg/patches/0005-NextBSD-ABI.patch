+/*
+ * NextBSD: is the running system NextBSD? kern.ostype (what uname -s prints)
+ * is "NextBSD" on the NextBSD kernel; uname(3) is asked as well in case the
+ * sysctl is not available. The ELF note cannot tell (see pkg_abi.h).
+ */
+static bool
+nextbsd_running(void)
+{
+	struct utsname un;
+#if __has_include(<sys/sysctl.h>)
+	char ostype[64];
+	size_t len = sizeof(ostype);
+
+	if (sysctlbyname("kern.ostype", ostype, &len, NULL, 0) == 0 &&
+	    len > 0 && len <= sizeof(ostype) && ostype[len - 1] == '\0' &&
+	    STREQ(ostype, "NextBSD"))
+		return (true);
+#endif
+	return (uname(&un) == 0 && STREQ(un.sysname, "NextBSD"));
+}
+
+/*
+ * NextBSD: a FreeBSD ELF ABI file read on NextBSD is a NextBSD one: the ABI
+ * becomes NextBSD:<osversion / 100000>:<arch>, with the osversion from the
+ * note (2700000 -> NextBSD:27). If the note carries no version, kern.osreldate
+ * gives it. An explicit ABI (env, -o or pkg.conf) never comes through here,
+ * so ABI=FreeBSD:15:<arch> with OSVERSION still selects FreeBSD packages.
+ */
+static void
+nextbsd_abi_from_freebsd(struct pkg_abi *abi)
+{
+	if (abi->os != PKG_OS_FREEBSD || !nextbsd_running())
+		return;
+	abi->os = PKG_OS_NEXTBSD;
+#if __has_include(<sys/sysctl.h>)
+	if (abi->major == 0) {
+		int osreldate = 0;
+		size_t len = sizeof(osreldate);
+
+		if (sysctlbyname("kern.osreldate", &osreldate, &len, NULL,
+		    0) == 0 && osreldate > 0)
+			pkg_abi_set_freebsd_osversion(abi, osreldate);
+	}
+#endif
+	pkg_debug(1, "NextBSD: the ABI file has a FreeBSD note; %s ABI, major %d",
+	    pkg_os_to_string(abi->os), abi->major);
+}
