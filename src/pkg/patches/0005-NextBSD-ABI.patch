+/*
+ * NextBSD: NextBSD's base is built from FreeBSD's sources, so its binaries
+ * carry FreeBSD's ELF ABI note (name "FreeBSD", desc __FreeBSD_version, which
+ * is 2700000 on NextBSD 27.0.0), and its libraries use FreeBSD's shlib naming.
+ * Its own ABI string is NextBSD:<major>:<arch> (NextBSD:27:amd64). Everything
+ * keyed on PKG_OS_FREEBSD that is about the osversion format, ELF objects or
+ * shlibs applies to NextBSD too; this says where.
+ */
+static inline bool
+pkg_os_is_freebsd_like(enum pkg_os os)
+{
+	return (os == PKG_OS_FREEBSD || os == PKG_OS_NEXTBSD);
+}
