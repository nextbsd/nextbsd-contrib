+/*
+ * NextBSD: the running system's NextBSD release, from kern.osrelease (what
+ * uname -r prints; "27.0.0" on NextBSD 27.0.0), or uname(3) if the sysctl is
+ * not available. Returns false unless the system is NextBSD, i.e. kern.ostype
+ * (uname -s) or uname(3) says "NextBSD", and the release starts <major>.<minor>.
+ * The release is used, not kern.osreldate or the ELF note: NextBSD may keep
+ * __FreeBSD_version at the releng/15.1 API level (1501000).
+ */
+static bool
+nextbsd_release(int *major, int *minor)
+{
+	struct utsname un;
+	char release[sizeof(un.release)];
+	bool nextbsd = false;
+	char *end;
+	long v;
+
+	release[0] = '\0';
+#if __has_include(<sys/sysctl.h>)
+	char ostype[64];
+	size_t len = sizeof(ostype);
+
+	if (sysctlbyname("kern.ostype", ostype, &len, NULL, 0) == 0 &&
+	    len > 0 && len <= sizeof(ostype) && ostype[len - 1] == '\0' &&
+	    STREQ(ostype, "NextBSD"))
+		nextbsd = true;
+	len = sizeof(release);
+	if (sysctlbyname("kern.osrelease", release, &len, NULL, 0) != 0 ||
+	    len == 0 || len > sizeof(release) || release[len - 1] != '\0')
+		release[0] = '\0';
+#endif
+	if (uname(&un) == 0) {
+		if (STREQ(un.sysname, "NextBSD"))
+			nextbsd = true;
+		if (release[0] == '\0')
+			strlcpy(release, un.release, sizeof(release));
+	}
+	if (!nextbsd)
+		return (false);
+
+	v = strtol(release, &end, 10);
+	if (end == release || *end != '.' || v < 1 || v > 999)
+		return (false);
+	*major = (int)v;
+	const char *m = end + 1;
+	v = strtol(m, &end, 10);
+	if (end == m || v < 0 || v > 99)
+		return (false);
+	*minor = (int)v;
+	return (true);
+}
+
+/*
+ * NextBSD: a FreeBSD ELF ABI file read on NextBSD is a NextBSD one. NextBSD's
+ * base carries FreeBSD's ELF note, whose version is __FreeBSD_version, so
+ * the version comes from the NextBSD release instead: kern.osrelease 27.0.0
+ * gives NextBSD:27:<arch> and OSVERSION 2700000 (<major> * 100000 +
+ * <minor> * 1000), whatever osreldate is. An explicit ABI (env, -o or
+ * pkg.conf) never comes through here, so ABI=FreeBSD:15:<arch> with OSVERSION
+ * still selects FreeBSD packages.
+ */
+static void
+nextbsd_abi_from_freebsd(struct pkg_abi *abi)
+{
+	int major, minor;
+
+	if (abi->os != PKG_OS_FREEBSD || !nextbsd_release(&major, &minor))
+		return;
+	abi->os = PKG_OS_NEXTBSD;
+	pkg_abi_set_freebsd_osversion(abi, major * 100000 + minor * 1000);
+	pkg_debug(1, "NextBSD: the ABI file has a FreeBSD note; %s ABI, "
+	    "release %d.%d", pkg_os_to_string(abi->os), major, minor);
+}
