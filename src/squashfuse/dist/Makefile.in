	-rm -f ./$(DEPDIR)/squashfuse_extract-nonstd-symlink.Po
	-rm -f ./$(DEPDIR)/squashfuse_extract-stat.Po
	-rm -f ./$(DEPDIR)/squashfuse_ll-ll_main.Po
	-rm -f tests/$(DEPDIR)/cachetest.Po
	-rm -f tests/$(DEPDIR)/endiantest.Po
	-rm -f tests/$(DEPDIR)/malformedtest.Po
	-rm -f Makefile
distclean-am: clean-am distclean-compile distclean-generic \
	distclean-hdr distclean-libtool distclean-tags

